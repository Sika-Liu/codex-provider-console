#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$PROJECT_DIR"

configured_cli_user() {
  local user
  user=$(sed -n 's/^CODEX_CLI_USER=//p' "$PROJECT_DIR/.env" 2>/dev/null | tail -n 1)
  printf '%s\n' "${user:-$(id -un)}"
}

run_as_cli_user() {
  local user="$1"
  local command="$2"
  if [[ "$(id -un)" == "$user" ]]; then
    bash -lc "$command"
  elif [[ "$(id -u)" -eq 0 ]]; then
    runuser -l "$user" -c "$command"
  else
    echo "Run this command as root to manage Codex CLI for ${user}." >&2
    return 1
  fi
}

ensure_cli_home_mount_path() {
  local cli_user="$1"
  local cli_home
  cli_home=$(getent passwd "$cli_user" | cut -d: -f6)
  [[ -n "$cli_home" ]] || { echo "Could not determine the home directory for ${cli_user}." >&2; return 1; }

  if grep -q '^CODEX_USER_HOME_CONTAINER_PATH=' "$PROJECT_DIR/.env"; then
    sed -i "s|^CODEX_USER_HOME_CONTAINER_PATH=.*|CODEX_USER_HOME_CONTAINER_PATH=${cli_home}|" "$PROJECT_DIR/.env"
  else
    printf 'CODEX_USER_HOME_CONTAINER_PATH=%s\n' "$cli_home" >> "$PROJECT_DIR/.env"
  fi
}

expose_codex_to_ssh() {
  local cli_user="$1"
  local cli_home candidate cli_bin system_bin="/usr/local/bin/codex"
  cli_home=$(getent passwd "$cli_user" | cut -d: -f6)
  [[ -n "$cli_home" ]] || { echo "Could not determine the home directory for ${cli_user}." >&2; return 1; }

  for candidate in \
    "$cli_home/.local/bin/codex" \
    "$cli_home/.codex/bin/codex" \
    "$cli_home/.codex/packages/standalone/current/bin/codex"; do
    if [[ -x "$candidate" ]]; then
      cli_bin="$candidate"
      break
    fi
  done
  [[ -n "${cli_bin:-}" ]] || { echo "Codex CLI executable was not found after installation." >&2; return 1; }

  if [[ -e "$system_bin" && ! -L "$system_bin" ]]; then
    echo "${system_bin} is a regular file; it was not replaced." >&2
    return 1
  fi
  if [[ -w "$(dirname "$system_bin")" ]]; then
    ln -sfn "$cli_bin" "$system_bin"
  elif command -v sudo >/dev/null 2>&1; then
    sudo ln -sfn "$cli_bin" "$system_bin"
  else
    echo "sudo is required to expose Codex CLI at ${system_bin}." >&2
    return 1
  fi
  echo "Prepared non-interactive SSH CLI path: ${system_bin} -> ${cli_bin}"
}

usage() {
  cat <<'EOF'
Usage: codex-panel <command>

Commands:
  start     Build and start the console
  stop      Stop the console
  restart   Rebuild and restart the console
  status    Show container status
  logs      Follow console logs
  update    Pull the latest Git revision and rebuild the console
  install-codex Install Codex CLI for the configured SSH user and refresh health status
  config    Print the active .env file path
  version   Print the installed console version
  uninstall Remove the console, then optionally remove Codex CLI
  help      Show this command reference
EOF
}

case "${1:-}" in
  start) docker compose up -d --build ;;
  stop) docker compose down ;;
  restart) docker compose up -d --build --force-recreate ;;
  status) docker compose ps ;;
  logs) docker compose logs -f --tail=100 codex-provider-console ;;
  update)
    git pull --ff-only
    cli_user=$(configured_cli_user)
    ensure_cli_home_mount_path "$cli_user"
    if id "$cli_user" >/dev/null 2>&1; then
      expose_codex_to_ssh "$cli_user" || true
    fi
    docker compose up -d --build --force-recreate
    ;;
  install-codex)
    if ! command -v curl >/dev/null 2>&1; then
      echo "curl is required to install Codex CLI. Install curl, then retry." >&2
      exit 1
    fi
    cli_user=$(configured_cli_user)
    id "$cli_user" >/dev/null 2>&1 || { echo "Configured Codex CLI user does not exist: $cli_user" >&2; exit 1; }
    echo "Installing Codex CLI for ${cli_user} with the official installer."
    run_as_cli_user "$cli_user" 'curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=true sh'
    version=$(run_as_cli_user "$cli_user" 'PATH="$HOME/.local/bin:$HOME/.codex/bin:$HOME/.codex/packages/standalone/current/bin:$PATH" codex --version | head -n 1')
    if [[ -z "$version" ]]; then
      echo "Codex CLI installation did not complete successfully." >&2
      exit 1
    fi
    expose_codex_to_ssh "$cli_user"
    if grep -q '^CODEX_CLI_VERSION=' "$PROJECT_DIR/.env"; then
      sed -i "s|^CODEX_CLI_VERSION=.*|CODEX_CLI_VERSION=${version}|" "$PROJECT_DIR/.env"
    else
      printf 'CODEX_CLI_VERSION=%s\n' "$version" >> "$PROJECT_DIR/.env"
    fi
    docker compose up -d --force-recreate
    echo "Codex CLI installed for ${cli_user}: ${version}"
    ;;
  config) printf '%s\n' "$PROJECT_DIR/.env" ;;
  version) cat "$PROJECT_DIR/VERSION" ;;
  uninstall)
    if [[ -z "${CODEX_HOME_HOST:-}" && -f "$PROJECT_DIR/.env" ]]; then
      CODEX_HOME_HOST=$(sed -n 's/^CODEX_HOME_HOST=//p' "$PROJECT_DIR/.env" | tail -n 1)
      CODEX_HOME_HOST=${CODEX_HOME_HOST#\"}
      CODEX_HOME_HOST=${CODEX_HOME_HOST%\"}
      CODEX_HOME_HOST=${CODEX_HOME_HOST#\'}
      CODEX_HOME_HOST=${CODEX_HOME_HOST%\'}
    fi
    CODEX_HOME_HOST="${CODEX_HOME_HOST:-$PROJECT_DIR/codex-data}"
    project_real=$(realpath -m "$PROJECT_DIR")
    data_real=$(realpath -m "$CODEX_HOME_HOST")
    [[ "$project_real" != "/" && "$project_real" != "$HOME" ]] || {
      echo "无法安全确认项目目录，卸载已取消。" >&2
      exit 1
    }

    cat <<EOF
即将卸载 Codex 控制台。

请选择处理方式：
  1. 卸载控制台，保留 Codex 数据（推荐）
  2. 卸载控制台，同时删除 Codex 数据、登录信息、会话和备份
  N. 取消
EOF
    read -r -p "请选择 [1/2/N]: " uninstall_mode
    case "${uninstall_mode:-N}" in
      1) REMOVE_CODEX=false ;;
      2) REMOVE_CODEX=true; echo "警告：选择 2 后，Codex 数据将无法恢复。" ;;
      *) echo "卸载已取消。"; exit 0 ;;
    esac

    read -r -p "确认执行卸载？[y/N]: " confirm
    case "${confirm:-n}" in
      y|Y|yes|YES) ;;
      *) echo "卸载已取消。"; exit 0 ;;
    esac

    if [[ "$REMOVE_CODEX" == true ]]; then
      codex_pids=$(pgrep -f '[c]odex app-server' || true)
      if [[ -n "$codex_pids" ]]; then
        echo
        echo "检测到 Codex 正在运行（进程：$codex_pids）。"
        echo "删除 Codex 数据前必须先停止这些进程；正在执行的任务可能会被中断。"
        read -r -p "确认停止进程并继续删除？[y/N]: " stop_confirm
        case "${stop_confirm:-n}" in
          y|Y|yes|YES) ;;
          *) echo "卸载已取消，Codex 数据未删除。"; exit 0 ;;
        esac

        kill $codex_pids 2>/dev/null || true
        for _ in {1..10}; do
          sleep 1
          remaining_pids=$(pgrep -f '[c]odex app-server' || true)
          [[ -z "$remaining_pids" ]] && break
        done
        if [[ -n "${remaining_pids:-}" ]]; then
          echo "Codex 进程未能在限定时间内退出，已停止卸载以避免缓存被重新创建。" >&2
          echo "请先关闭 Codex 后重新执行 codex-panel uninstall。" >&2
          exit 1
        fi
        echo "Codex 进程已停止，继续删除数据。"
      fi
    fi

    if [[ "$REMOVE_CODEX" == false && ( "$data_real" == "$project_real" || "$data_real" == "$project_real/"* ) ]]; then
      preserved="$HOME/.codex-preserved-$(date +%Y%m%d-%H%M%S)"
      echo "检测到数据位于项目目录内，正在将数据保留到：$preserved"
      mkdir -p "$(dirname "$preserved")"
      mv -- "$data_real" "$preserved"
      data_real="$preserved"
    fi

    project_images=""
    if command -v docker >/dev/null 2>&1; then
      project_images=$(docker compose images -q 2>/dev/null | sort -u || true)
      docker compose --profile reverse-proxy down --remove-orphans
    else
      echo "未检测到 Docker，跳过容器清理。"
    fi

    if [[ -n "$project_images" ]] && command -v docker >/dev/null 2>&1; then
      while IFS= read -r image_id; do
        [[ -n "$image_id" ]] && docker image rm "$image_id" >/dev/null 2>&1 || true
      done <<< "$project_images"
    fi

    cli_link="/usr/local/bin/codex"
    if [[ -L "$cli_link" ]]; then
      cli_target=$(readlink -f "$cli_link" 2>/dev/null || true)
      if [[ "$cli_target" == "$HOME/.local/bin/codex" || "$cli_target" == "$HOME/.codex/"* || "$cli_target" == "$data_real/"* ]]; then
        if [[ -w "$(dirname "$cli_link")" ]]; then
          rm -f -- "$cli_link"
        elif command -v sudo >/dev/null 2>&1; then
          sudo rm -f -- "$cli_link"
        fi
      fi
    fi

    rm -f -- "$HOME/.local/bin/codex-panel"
    if [[ -f "$HOME/.bashrc" ]]; then
      sed -i '/^export PATH="\$HOME\/\.local\/bin:\$PATH"$/d' "$HOME/.bashrc"
    fi
    rm -rf -- "$PROJECT_DIR"

    if [[ "$REMOVE_CODEX" == true ]]; then
      rm -f -- "$HOME/.local/bin/codex"
      rm -rf -- "$data_real"
      if [[ "$data_real" != "$HOME/.codex" && -d "$HOME/.codex" ]]; then
        rm -rf -- "$HOME/.codex"
      fi
      if [[ -e "$data_real" || -e "$HOME/.codex" ]]; then
        echo "控制台已卸载，但 Codex 数据仍有残留，请检查：$data_real" >&2
        exit 1
      fi
      echo "控制台和 Codex 数据已删除，已确认无残留。"
    else
      echo "控制台已卸载，Codex 数据已保留：$data_real"
    fi
    echo "如需重新安装，请重新运行安装命令。"
    ;;
  -h|--help|help|'') usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 1 ;;
esac
