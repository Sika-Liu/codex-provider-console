#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$PROJECT_DIR"

usage() {
  cat <<'EOF'
Usage: codex-panel <command>

Commands:
  start     Build and start the console
  stop      Stop the console
  restart   Rebuild and restart the console
  status    Show container status
  logs      Follow console logs
  update    Pull the latest Git revision and rebuild the console
  config    Print the active .env file path
  uninstall Remove the console, then optionally remove Codex CLI and Docker
  help      Show this command reference
EOF
}

case "${1:-}" in
  start) docker compose up -d --build ;;
  stop) docker compose down ;;
  restart) docker compose up -d --build --force-recreate ;;
  status) docker compose ps ;;
  logs) docker compose logs -f --tail=100 codex-provider-console ;;
  update)
    git pull --ff-only
    docker compose up -d --build
    ;;
  config) printf '%s\n' "$PROJECT_DIR/.env" ;;
  uninstall)
    if [[ -z "${CODEX_HOME_HOST:-}" && -f "$PROJECT_DIR/.env" ]]; then
      CODEX_HOME_HOST=$(sed -n 's/^CODEX_HOME_HOST=//p' "$PROJECT_DIR/.env" | tail -n 1)
      CODEX_HOME_HOST=${CODEX_HOME_HOST#\"}
      CODEX_HOME_HOST=${CODEX_HOME_HOST%\"}
      CODEX_HOME_HOST=${CODEX_HOME_HOST#\'}
      CODEX_HOME_HOST=${CODEX_HOME_HOST%\'}
    fi
    CODEX_HOME_HOST="${CODEX_HOME_HOST:-$PROJECT_DIR/codex-data}"
    read -r -p "This permanently deletes the console, .env, and its Docker image. Continue? [y/N]: " confirm
    case "${confirm:-n}" in
      y|Y|yes|YES)
        if command -v docker >/dev/null 2>&1; then
          docker compose down --remove-orphans
          docker image rm codex-provider-console-codex-provider-console:latest 2>/dev/null || true
        else
          echo "Docker is not installed; skipping container cleanup."
        fi
        rm -f -- "$HOME/.local/bin/codex-panel"
        rm -rf -- "$PROJECT_DIR"
        echo "Codex Provider Console was removed."

        read -r -p "Remove Codex CLI and Codex data at ${CODEX_HOME_HOST}? [y/N]: " remove_codex
        case "${remove_codex:-n}" in
          y|Y|yes|YES)
            rm -f -- "$HOME/.local/bin/codex"
            rm -rf -- "$CODEX_HOME_HOST"
            if [[ "$CODEX_HOME_HOST" != "$HOME/.codex" ]]; then
              rm -rf -- "$HOME/.codex"
            fi
            echo "Codex CLI and Codex data were removed."
            ;;
          *) echo "Codex CLI and Codex data were kept." ;;
        esac

        if command -v docker >/dev/null 2>&1; then
          read -r -p "Remove Docker Engine and all Docker data on this server? This can affect other services. [y/N]: " remove_docker
          case "${remove_docker:-n}" in
            y|Y|yes|YES)
              [[ -r /etc/os-release ]] && . /etc/os-release || true
              if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
                run_privileged() { "$@"; }
              elif command -v sudo >/dev/null 2>&1; then
                run_privileged() { sudo "$@"; }
              else
                echo "Root or sudo access is required to remove Docker." >&2
                exit 1
              fi

              run_privileged systemctl disable --now docker docker.socket containerd 2>/dev/null || true
              case "${ID:-}:${ID_LIKE:-}" in
                ubuntu:*|debian:*|*:debian)
                  packages=()
                  for package in docker.io docker-ce docker-ce-cli docker-compose-plugin docker-compose-v2 docker-buildx-plugin containerd.io; do
                    dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed && packages+=("$package")
                  done
                  ((${#packages[@]})) && run_privileged apt-get purge -y "${packages[@]}"
                  ;;
                centos:*|rhel:*|rocky:*|almalinux:*|fedora:*|ol:*|*:rhel|*:fedora)
                  packages=()
                  for package in docker-ce docker-ce-cli docker-ce-rootless-extras docker-buildx-plugin docker-compose-plugin docker.io containerd.io; do
                    rpm -q "$package" >/dev/null 2>&1 && packages+=("$package")
                  done
                  if ((${#packages[@]})); then
                    if command -v dnf >/dev/null 2>&1; then
                      run_privileged dnf remove -y "${packages[@]}"
                    else
                      run_privileged yum remove -y "${packages[@]}"
                    fi
                  fi
                  ;;
                *)
                  echo "Automatic Docker removal is not configured for this distribution; Docker was kept." >&2
                  exit 0
                  ;;
              esac
              run_privileged rm -rf /var/lib/docker /var/lib/containerd /etc/docker
              echo "Docker Engine and Docker data were removed."
              ;;
            *) echo "Docker was kept." ;;
          esac
        else
          echo "Docker is not installed; skipping Docker removal."
        fi
        ;;
      *) echo "Uninstall cancelled." ;;
    esac
    ;;
  -h|--help|help|'') usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 1 ;;
esac
