# Host directory containing the user's Codex config.toml and auth.json.
# Use an absolute path in production, for example /home/alice/.codex.
# Prefer the installer: it fills in the current non-root user's paths and IDs.
CODEX_HOME_HOST=./codex-data

# The default binds locally for SSH-tunnel access. Use 0.0.0.0 only with HTTPS
# and cloud firewall restrictions.
# Local-only by default. Use 0.0.0.0 only with HTTPS and firewall restrictions.
PANEL_BIND=127.0.0.1
PANEL_PORT=8787
RELAY_PORT=57321
HOST_RELAY_BASE_URL=http://127.0.0.1:57321/v1

# Match the owner of CODEX_HOME_HOST so the container can write private files.
PUID=1000
PGID=1000

# Panel login. Run bash install.sh to generate secure values automatically.
PANEL_AUTH_ENABLED=true
PANEL_USERNAME=admin
PANEL_PASSWORD=change-this-password
PANEL_SESSION_SECRET=change-this-session-secret
# Set true only when the panel is served through HTTPS.
PANEL_COOKIE_SECURE=false
# Optional: host/IP alias already present in known_hosts. When empty, the
# Docker gateway address itself must have a verified entry in known_hosts.
PANEL_SSH_HOST_ALIAS=
CODEX_CLI_VERSION=not_installed
# Non-root operational account. The installer sets both values.
# Replace these placeholders when editing .env manually; do not use root for
# normal deployments.
CODEX_CLI_USER=replace-with-deploy-user
DEPLOY_USER=replace-with-deploy-user
# Deployment user's home directory. It lets the health check install Codex CLI
# and update the user's shell profile when needed.
CODEX_USER_HOME_HOST=./codex-user-home
